<Window x:Class="ASX11Battery.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Settings" Width="340" Height="390" MinWidth="340" MinHeight="390"
        MaxWidth="340" MaxHeight="390" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="14" GlassFrameThickness="0"
                            ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="18,0,0,0" MouseLeftButtonDown="OnTitleBarDrag"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                <TextBlock Text="Settings" VerticalAlignment="Center" FontFamily="{StaticResource UiFont}"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Grid.Column="1" Style="{StaticResource CaptionCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClick" ToolTip="Close">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyph}" FontSize="9"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Margin="24,17,24,12">
                <TextBlock Text="Preferences" Style="{StaticResource CardTitle}" FontFamily="{StaticResource UiFont}" />
                <TextBlock Text="Choose how ASX11 Battery monitors and alerts you." Style="{StaticResource Caption}" Margin="0,4,0,16" />
                <CheckBox x:Name="DetectChargingCheckBox" Content="Detect charging" Style="{StaticResource AppCheckBox}"
                          Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                <TextBlock Text="Charging status is unavailable when detection is off." Style="{StaticResource Caption}" Margin="31,4,0,14" />
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14" />
                <CheckBox x:Name="BatteryNotificationsCheckBox" Content="Battery notifications" Style="{StaticResource AppCheckBox}"
                          Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                <Grid Margin="31,11,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Low battery threshold" VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBox x:Name="ThresholdTextBox" Grid.Column="1" Style="{StaticResource AppTextBox}" Padding="8,5"
                             MaxLength="3" TextChanged="OnThresholdChanged" />
                    <TextBlock Grid.Column="2" Text="%" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                </Grid>
                <TextBlock Text="Alert once when battery drops to or below this level." Style="{StaticResource Caption}" Margin="31,5,0,0" />
            </StackPanel>
            <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,0">
                <Button Style="{StaticResource PrimaryButton}" Content="Done" HorizontalAlignment="Right"
                        MinWidth="86" Padding="14,7" Click="OnCloseClick" />
            </Border>
        </Grid>
    </Border>
</Window>
