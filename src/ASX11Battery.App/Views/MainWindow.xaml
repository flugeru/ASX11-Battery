<Window x:Class="ASX11Battery.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:ASX11Battery.App.Controls"
        mc:Ignorable="d"
        Title="ASX11 Battery"
        Width="360" Height="500"
        MinWidth="360" MinHeight="500"
        MaxWidth="360" MaxHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ResizeMode="NoResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="14" GlassFrameThickness="0"
                            ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Root" Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="14" Padding="0" SnapsToDevicePixels="True">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,0,0,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  MouseLeftButtonDown="OnTitleBarDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="22" Height="22" Stretch="Uniform"
                           Source="/ASX11Battery.App;component/Assets/ASX11Battery.ico" />
                    <TextBlock Text="ASX11 Bateria" Margin="9,0,0,1" FontFamily="{StaticResource UiFont}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnSettingsClick" ToolTip="Configurações">
                    <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" FontSize="12"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource CaptionCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnCloseClick" ToolTip="Fechar">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyph}" FontSize="9"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="24,10,24,8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Bateria" HorizontalAlignment="Center" FontFamily="{StaticResource UiFont}"
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,0,8" />
                <controls:BatteryRing Width="212" Height="212" Margin="0,0,0,20"
                                       BatteryPercent="{Binding PrimaryDevice.BatteryPercent}"
                                       Caption="{Binding PrimaryDevice.RingCaption}"
                                       Charging="{Binding PrimaryDevice.Charging}" />
                <TextBlock Text="{Binding PrimaryDevice.Name}" HorizontalAlignment="Center"
                           Margin="0,0,0,6" FontFamily="{StaticResource UiFont}" FontSize="16"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <StackPanel Margin="0,6,0,8" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                             Fill="{DynamicResource BadgePositiveTextBrush}" />
                    <TextBlock Text="{Binding PrimaryDevice.StateText}" FontFamily="{StaticResource UiFont}"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding PrimaryDevice.StatusMessage}" HorizontalAlignment="Center"
                           Margin="0,0,0,0" FontFamily="{StaticResource UiFont}" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="280" />
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                    Padding="16,10">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PrimaryDevice.LastUpdateText}" FontFamily="{StaticResource UiFont}"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Text="Leitura local · HID" FontFamily="{StaticResource UiFont}"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
