<Window x:Class="ASX11Battery.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:ASX11Battery.App.ViewModels"
        xmlns:controls="clr-namespace:ASX11Battery.App.Controls"
        xmlns:conv="clr-namespace:ASX11Battery.App.Converters"
        mc:Ignorable="d"
        Title="ASX11 Battery"
        Width="760" Height="530"
        MinWidth="760" MinHeight="530"
        MaxWidth="760" MaxHeight="530"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.InputBindings>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding ShowDashboardCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding ShowSettingsCommand}" />
        <KeyBinding Key="G" Modifiers="Ctrl" Command="{Binding ShowDiagnosticsCommand}" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding ShowAboutCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="WindowSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Root" Style="{StaticResource WindowSurface}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270"
                              Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= Title bar ================= -->
            <Grid Grid.Row="0" Height="{StaticResource TitleBarHeight}"
                  Background="{DynamicResource SidebarBrush}"
                  MouseLeftButtonDown="OnTitleBarDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="17" Height="17" CornerRadius="5"
                            Background="{DynamicResource AccentBrush}" Opacity="0.9" />
                    <TextBlock Text="ASX11 Battery" Margin="9,0,0,0"
                               FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionCloseButton}" Click="OnCloseClick"
                            ToolTip="Fechar">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyph}"
                                   FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="184" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= Side bar ================= -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,0,0,1" Padding="20,22,20,22">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="36" Height="36" CornerRadius="10"
                                            Background="{DynamicResource AccentBrush}"
                                            Effect="{StaticResource AccentShadow}">
                                        <TextBlock Text="&#xE1A6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="18" Foreground="{DynamicResource OnAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="ASX11 Battery" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Attack Shark X11" FontSize="10.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="14,18,14,0">
                            <TextBlock Text="NAVEGAÇÃO" Style="{StaticResource Caption}"
                                       FontWeight="SemiBold" Margin="6,0,0,8" />

                            <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" GroupName="Nav"
                                         Content="Bateria" IsChecked="{Binding IsDashboardSelected, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                         Content="Configurações" IsChecked="{Binding IsSettingsSelected, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                         Content="Diagnóstico" IsChecked="{Binding IsDiagnosticsSelected, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                         Content="Sobre" IsChecked="{Binding IsAboutSelected, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="20,10,20,20">
                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMedium}" Padding="13,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="7"
                                                Background="{DynamicResource AccentGlowBrush}">
                                            <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Privacidade" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" Margin="9,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,7,0,0"
                                               Text="Leitura local. Sem telemetria, sem rede e sem administrador." />
                                </StackPanel>
                            </Border>

                            <Button Content="Sair" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Stretch" Margin="0,10,0,0"
                                    Command="{Binding ExitCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- ================= Page header ================= -->
                        <Grid Grid.Row="0" Margin="24,18,24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding PageTitle}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0"
                                           Text="{Binding StatusHeadline}" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource Badge}"
                                    Background="Transparent" Margin="16,0,0,0" Padding="13,6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding VersionText}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ================= Dashboard ================= -->
                        <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto"
                                      Padding="24,0,24,24" Visibility="{Binding DashboardVisibility}">
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                                                Padding="22">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <controls:BatteryRing Grid.Column="0"
                                                                     Width="150" Height="150"
                                                                     BatteryPercent="{Binding BatteryPercent}"
                                                                     Caption="{Binding RingCaption}"
                                                                     Charging="{Binding Charging}" />

                                                <StackPanel Grid.Column="1" Margin="20,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Caption}"
                                                               Text="Seu mouse" />

                                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                        <Border Width="34" Height="34" CornerRadius="10"
                                                                Background="{DynamicResource AccentSoftBrush}">
                                                            <TextBlock Text="{Binding Glyph}"
                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       FontSize="15" Foreground="{DynamicResource AccentBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontSize="18"
                                                                   FontWeight="SemiBold" Margin="12,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                        <Border Style="{StaticResource Badge}" Margin="0,0,8,0">
                                                            <TextBlock Style="{StaticResource BadgeText}"
                                                                       Text="{Binding ConnectionText}" />
                                                        </Border>
                                                        <Border Style="{StaticResource BadgePositive}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="5" Height="5"
                                                                         Fill="{DynamicResource BadgePositiveTextBrush}"
                                                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBlock Style="{StaticResource BadgeTextPositive}"
                                                                           Text="{Binding StateText}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <Border Height="1" Background="{DynamicResource DividerBrush}"
                                                            Margin="0,18,0,16" />

                                                    <TextBlock Style="{StaticResource Muted}"
                                                               Text="{Binding StatusMessage}" />

                                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                        <TextBlock Text="&#xE823;" Style="{StaticResource IconGlyph}"
                                                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                        <TextBlock Style="{StaticResource Mono}" Margin="7,0,0,0"
                                                                   Text="{Binding LastUpdateText}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- ================= Settings ================= -->
                        <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto"
                                      Padding="32,0,32,32" Visibility="{Binding SettingsVisibility}">
                            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Inicialização" />

                                        <StackPanel Margin="0,16,0,0">
                                            <CheckBox Style="{StaticResource AppCheckBox}"
                                                      IsChecked="{Binding StartWithWindows}"
                                                      Content="Iniciar com o Windows" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="31,5,0,0"
                                                       Text="Usa a chave Run do seu usuario. Sem servico, sem driver, sem elevacao." />
                                        </StackPanel>

                                        <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,16,0,0"
                                                  IsChecked="{Binding StartMinimized}"
                                                  Content="Iniciar minimizado" />

                                        <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,16,0,0"
                                                  IsChecked="{Binding CloseToTray}"
                                                  Content="Fechar a janela minimiza para a bandeja" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Bateria e notificações" />

                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Muted}"
                                                       Text="Avisar abaixo de" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Style="{StaticResource BadgePositive}"
                                                    Padding="13,4">
                                                <TextBlock Style="{StaticResource BadgeTextPositive}"
                                                           Text="{Binding LowBatteryThreshold, StringFormat={}{0}%}" />
                                            </Border>
                                        </Grid>
                                        <Slider Style="{StaticResource AppSlider}" Margin="0,14,0,4"
                                                Minimum="5" Maximum="90" TickFrequency="5"
                                                Value="{Binding LowBatteryThreshold}" />

                                        <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,16,0,0"
                                                  IsChecked="{Binding NotifyLowBattery}"
                                                  Content="Notificar bateria baixa" />
                                        <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,16,0,0"
                                                  IsChecked="{Binding NotifyCharging}"
                                                  Content="Notificar inicio/fim de carga" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Dispositivo" />

                                        <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,16,0,0"
                                                  IsChecked="{Binding ShowDisconnected}"
                                                  Content="Manter o cartao visivel quando o mouse estiver desconectado" />

                                        <Border Background="{DynamicResource InputBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusMedium}"
                                                Padding="16,14" Margin="0,18,0,0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE946;" Style="{StaticResource IconGlyph}"
                                                               FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Text="Leitura somente, por definicao" FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="8,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Caption}" Margin="0,7,0,0"
                                                           Text="O X11 transmite a bateria sozinho. O aplicativo abre a colecao HID apenas para leitura e nao possui nenhuma rota de escrita, entao nao ha o que ativar aqui." />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= Diagnostics ================= -->
                        <Grid Grid.Row="1" Margin="0,22,0,0" Visibility="{Binding DiagnosticsVisibility}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="32,0,32,16">
                                <Button Content="Copiar informacoes de diagnostico" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CopyDiagnosticsCommand}" />
                                <TextBlock Text="{Binding CopyFeedback}" Margin="14,0,0,0" VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>

                            <TextBox Grid.Row="1" Margin="32,0,32,32"
                                     Style="{StaticResource AppTextBox}"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="{StaticResource FontSizeCaption}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Text="{Binding DiagnosticText, Mode=OneWay}" />
                        </Grid>

                        <!-- ================= About ================= -->
                        <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto"
                                      Padding="32,0,32,32" Visibility="{Binding AboutVisibility}">
                            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                                <Border Style="{StaticResource CardElevated}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="52" Height="52" CornerRadius="15"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Effect="{StaticResource AccentShadow}">
                                                <TextBlock Text="&#xE1A6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="26" Foreground="{DynamicResource OnAccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="ASX11 Battery" FontSize="19" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                                           Text="{Binding VersionText, StringFormat=Versão {0}}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource Muted}" Margin="0,20,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Monitor local de bateria para o Attack Shark X11. Lê o percentual direto do relatório HID, sem estimativas." />

                                        <Border Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="{StaticResource RadiusMedium}"
                                                Padding="14,11" Margin="0,18,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE779;" Style="{StaticResource IconGlyph}"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <StackPanel Margin="9,0,0,0">
                                                    <TextBlock Text="Fale com o criador" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="Discord: .flugel." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Como funciona" />
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="O mouse envia pelo receptor USB um relatorio de 5 bytes cuja assinatura e 03 55 40 01. O quinto byte e a porcentagem. Nada e escrito no aparelho: a colecao HID e aberta somente para leitura, e o aplicativo nao tem nenhuma funcao capaz de enviar um byte." />
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"
                                                   Text="Quando a leitura nao volta - receptor desencaixado, mouse dormindo, cabo sem o contato de carga - o aplicativo mostra bateria indisponivel. Ele nunca preenche o espaco com um numero estimado." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Privacidade" />
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                                                   Text="Tudo roda localmente. Sem telemetria, sem acesso a internet, sem servico em segundo plano, sem instalacao de driver e sem pedido de administrador. A unica configuracao gravada e um arquivo JSON na sua pasta de perfil." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Atalhos" />
                                        <UniformGrid Margin="0,12,0,0" Columns="2">
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,18,8" Text="Ctrl+D · Bateria" />
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" Text="Ctrl+G · Diagnóstico" />
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,18,0" Text="Ctrl+S · Configurações" />
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,0" Text="Ctrl+B · Sobre" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>