<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         Dark theme (default). Every key here has a counterpart in
         Light.xaml, so a theme switch is a straight dictionary swap.
         ================================================================ -->

    <!-- Neutral charcoal theme: dark gray surfaces, restrained cyan accent. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#181A1E" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#202226" />
    <SolidColorBrush x:Key="CardBrush" Color="#27292E" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#303238" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#35373D" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#41434A" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#383B42" />
    <SolidColorBrush x:Key="InputBrush" Color="#1D1F23" />

    <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3D44" />
    <SolidColorBrush x:Key="DividerBrush" Color="#34373D" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#555961" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C1C4CA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E939C" />

    <SolidColorBrush x:Key="AccentBrush" Color="#53D6C0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#79E5D3" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#102322" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#29433F" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#293B3A" />

    <SolidColorBrush x:Key="BadgeBrush" Color="#303238" />
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#464950" />
    <SolidColorBrush x:Key="BadgePositiveBrush" Color="#24413A" />
    <SolidColorBrush x:Key="BadgePositiveBorderBrush" Color="#3B6E60" />
    <SolidColorBrush x:Key="BadgePositiveTextBrush" Color="#8BE8D1" />

    <SolidColorBrush x:Key="LevelCriticalBrush" Color="#FF7582" />
    <SolidColorBrush x:Key="LevelLowBrush" Color="#FFC56C" />
    <SolidColorBrush x:Key="LevelGoodBrush" Color="#53D6C0" />
    <SolidColorBrush x:Key="LevelFullBrush" Color="#70BDF5" />
    <SolidColorBrush x:Key="LevelUnknownBrush" Color="#4A4E57" />

    <SolidColorBrush x:Key="TrackBrush" Color="#3A3D45" />
    <SolidColorBrush x:Key="RingGlowBrush" Color="#2B3D3A" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#626771" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#7B808B" />

    <SolidColorBrush x:Key="TooltipBrush" Color="#2B2D32" />
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#F0F1F3" />

    <SolidColorBrush x:Key="OfflineBrush" Color="#858A93" />
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#D94B58" />
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#FFFFFF" Opacity="0.08" />

</ResourceDictionary>