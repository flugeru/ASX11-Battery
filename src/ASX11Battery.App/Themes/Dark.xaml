<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         Dark theme (default). Every key here has a counterpart in
         Light.xaml, so a theme switch is a straight dictionary swap.
         ================================================================ -->

    <!-- Quiet Windows utility palette: one surface, restrained live accent. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#17191D" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#1B1E23" />
    <SolidColorBrush x:Key="CardBrush" Color="#202329" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#282C33" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2A2E35" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#343941" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#292E35" />
    <SolidColorBrush x:Key="InputBrush" Color="#1A1D22" />

    <SolidColorBrush x:Key="StatusWarningBrush" Color="#F2B866" />
    <SolidColorBrush x:Key="StatusWarningSoftBrush" Color="#493823" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#FF7D8A" />
    <SolidColorBrush x:Key="StatusErrorSoftBrush" Color="#48252D" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#7DBCF2" />
    <SolidColorBrush x:Key="StatusInfoSoftBrush" Color="#253B50" />
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="#A2AAB6" />
    <SolidColorBrush x:Key="StatusOfflineSoftBrush" Color="#2A3039" />

    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFFFFF" Opacity="0.075" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FFFFFF" Opacity="0.07" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#FFFFFF" Opacity="0.16" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C8CAD0" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#969AA3" />

    <SolidColorBrush x:Key="AccentBrush" Color="#8AC8FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#A9D8FF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#15202A" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#27343F" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#29343F" />

    <SolidColorBrush x:Key="BadgeBrush" Color="#282B31" />
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#FFFFFF" Opacity="0.1" />
    <SolidColorBrush x:Key="BadgePositiveBrush" Color="#24352F" />
    <SolidColorBrush x:Key="BadgePositiveBorderBrush" Color="#52766A" />
    <SolidColorBrush x:Key="BadgePositiveTextBrush" Color="#A6D9C9" />

    <SolidColorBrush x:Key="LevelCriticalBrush" Color="#F28B96" />
    <SolidColorBrush x:Key="LevelLowBrush" Color="#E8B978" />
    <SolidColorBrush x:Key="LevelGoodBrush" Color="#79C9B7" />
    <SolidColorBrush x:Key="LevelFullBrush" Color="#8AC8FF" />
    <SolidColorBrush x:Key="LevelUnknownBrush" Color="#5A5F69" />

    <SolidColorBrush x:Key="TrackBrush" Color="#34383F" />
    <SolidColorBrush x:Key="RingGlowBrush" Color="#243037" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#626771" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#7B808B" />

    <SolidColorBrush x:Key="TooltipBrush" Color="#2B2D32" />
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#F0F1F3" />

    <SolidColorBrush x:Key="OfflineBrush" Color="#858A93" />
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#FFFFFF" Opacity="0.06" />

</ResourceDictionary>